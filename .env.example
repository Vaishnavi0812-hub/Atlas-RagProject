# Copy to .env and adjust. Never commit .env.

# --- Application ---
ENVIRONMENT=development
APP_NAME=ATLAS
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- PostgreSQL ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=atlas_dev_password

# --- AI provider (used from Stage 3/4) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Host ports (chosen to avoid clashing with other local projects) ---
POSTGRES_HOST_PORT=5442
NEO4J_HTTP_HOST_PORT=7475
NEO4J_BOLT_HOST_PORT=7688
QDRANT_HOST_PORT=6335
REDIS_HOST_PORT=6380
API_HOST_PORT=8010
